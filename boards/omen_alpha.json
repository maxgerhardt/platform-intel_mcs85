{
  "build": {
    "core": "baremetal",
    "cpu": "i8085",
    "mcu": "i8085",
    "f_cpu": "2000000L",
    "undocumented_insns": "no"
  },
  "frameworks": [
    "baremetal"
  ],
  "name": "OMEN ALPHA (Intel 8085)",
  "debug": {
    "tools": {
      "i8085-trace": {
        "server": {
          "package": "tool-i8085-trace",
          "executable": "bin/i8085-trace.exe",
          "arguments": [
            "--gdb=$DEBUG_PORT",
            "--io-plugin=$PACKAGE_DIR/plugins/mc6850_28c256.dll",
            "--io-plugin-config=tcp=5555;gdbtx=1",
            "$PROG_PATH"
          ]
        },
        "init_cmds": [
          "define pio_reset_halt_target",
          "end",
          "define pio_reset_run_target",
          "end",
          "target remote $DEBUG_PORT",
          "$LOAD_CMDS",
          "$INIT_BREAK"
        ],
        "load_cmds": [],
        "init_break": "tbreak main",
        "default": true
      }
    }
  },
  "upload": {
    "maximum_ram_size": 32768,
    "maximum_size": 24576,
    "protocol": "hexload",
    "protocols": [
      "hexload",
      "i8085-trace"
    ],
    "speed": 115200
  },
  "url": "https://deramp.com/omen.html",
  "vendor": "OMEN Computer (homebrew)"
}
